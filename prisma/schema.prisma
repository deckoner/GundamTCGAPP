generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model animes {
  id    Int     @id @default(autoincrement())
  anime String? @unique(map: "anime") @db.VarChar(255)

  cards cards[]
}

model card_colors {
  card_id  Int
  color_id Int

  cards  cards  @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  color colors @relation(fields: [color_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([card_id, color_id])
  @@index([color_id], map: "idx_card_colors_color")
}

model card_tags {
  card_id Int
  tag_id  Int

  cards cards @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tag   tags  @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([card_id, tag_id])
  @@index([tag_id], map: "idx_card_tags_tag")
}

model card_types {
  card_id Int
  type_id Int

  cards cards @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  type types @relation(fields: [type_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([card_id, type_id])
  @@index([type_id], map: "idx_card_types_type")
}

model card_variants {
  id               Int                @id @default(autoincrement())
  card_id          Int
  set_id           Int
  rarity           String?            @db.VarChar(64)
  img              String             @db.VarChar(255)
  alt_art          Boolean            @default(false)
  cards            cards              @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "card_variants_ibfk_1")
  sets             sets               @relation(fields: [set_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "card_variants_ibfk_2")
  deck_cards       deck_cards[]
  user_collections user_collections[]

  @@unique([card_id, set_id, img], map: "card_id")
  @@index([card_id], map: "idx_card_variants_card")
  @@index([rarity], map: "idx_card_variants_rarity")
  @@index([set_id], map: "idx_card_variants_set")
}

model cards {
  id            Int             @id @default(autoincrement())
  gd            String          @unique(map: "gd") @db.VarChar(64)
  name          String          @db.VarChar(255)
  level         Int?
  cost          Int?
  text_card     String?         @db.Text
  ap            Int?
  hp            Int?
  traits        String?         @db.Text
  links         String?         @db.Text
  zone_id       Int?
  anime_id      Int?
  card_variants card_variants[]
  card_colors   card_colors[]
  card_types    card_types[]
  card_tags     card_tags[]
  zones         zones?          @relation(fields: [zone_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cards_ibfk_1")
  animes        animes?         @relation(fields: [anime_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cards_ibfk_2")
  deck_cards    deck_cards[]

  @@index([anime_id], map: "anime_id")
  @@index([name], map: "idx_cards_name")
  @@index([zone_id], map: "zone_id")
}

model colors {
  id    Int     @id @default(autoincrement())
  color String? @unique(map: "color") @db.VarChar(255)

  card_colors card_colors[]
}

model deck_cards {
  deck_id              Int
  card_id              Int
  quantity             Int?           @default(1)
  zone                 String         @default("main") @db.VarChar(32)
  preferred_variant_id Int?
  decks                decks          @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "deck_cards_ibfk_1")
  cards                cards          @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "deck_cards_ibfk_2")
  card_variants        card_variants? @relation(fields: [preferred_variant_id], references: [id], onUpdate: Restrict, map: "deck_cards_ibfk_3")

  @@id([deck_id, card_id, zone])
  @@index([card_id], map: "card_id")
  @@index([deck_id], map: "idx_deck_cards_deck")
  @@index([preferred_variant_id], map: "preferred_variant_id")
}

model decks {
  id          Int          @id @default(autoincrement())
  user_id     Int
  name        String       @db.VarChar(255)
  description String?      @db.Text
  format      String?      @default("gundam") @db.VarChar(64)
  created_at  DateTime?    @default(now()) @db.Timestamp(0)
  updated_at  DateTime?    @default(now()) @db.Timestamp(0)
  deck_cards  deck_cards[]
  users       users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "decks_ibfk_1")

  @@index([user_id], map: "user_id")
}

model sets {
  id            Int             @id @default(autoincrement())
  code          String?         @unique(map: "code") @db.VarChar(255)
  name          String?         @db.VarChar(255)
  full_name     String?         @unique(map: "full_name") @db.VarChar(255)
  sort_order    Int?            @default(0)
  card_variants card_variants[]
}

model tags {
  id  Int     @id @default(autoincrement())
  tag String? @unique(map: "tag") @db.VarChar(255)

  card_tags card_tags[]
}

model types {
  id   Int    @id @default(autoincrement())
  type String? @unique(map: "type") @db.VarChar(255)

  card_types card_types[]
}

model user_collections {
  user_id       Int
  variant_id    Int
  quantity      Int?          @default(1)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_collections_ibfk_1")
  card_variants card_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_collections_ibfk_2")

  @@id([user_id, variant_id])
  @@index([user_id], map: "idx_user_collections_user")
  @@index([variant_id], map: "variant_id")
}

model users {
  id               Int                @id @default(autoincrement())
  username         String             @unique(map: "username") @db.VarChar(255)
  password_hash    String?            @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  decks            decks[]
  user_collections user_collections[]
}

model zones {
  id    Int     @id @default(autoincrement())
  zone  String? @unique(map: "zone") @db.VarChar(255)

  cards cards[]
}
